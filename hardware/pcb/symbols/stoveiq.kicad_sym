(kicad_symbol_lib
  (version 20231120)
  (generator "custom")
  (generator_version "8.0")

  ;; MLX90640 Far-IR Thermal Sensor Array
  ;; 4-pin package: VDD, VSS, SDA, SCL
  (symbol "MLX90640ESF"
    (exclude_from_sim no)
    (in_bom yes)
    (on_board yes)
    (property "Reference" "U"
      (at 0 8.89 0)
      (effects (font (size 1.27 1.27)))
    )
    (property "Value" "MLX90640ESF"
      (at 0 6.35 0)
      (effects (font (size 1.27 1.27)))
    )
    (property "Footprint" ""
      (at 0 0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Datasheet" "https://www.melexis.com/en/documents/documentation/datasheets/datasheet-mlx90640"
      (at 0 0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Description" "32x24 Far-Infrared Thermal Sensor Array, I2C"
      (at 0 0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (symbol "MLX90640ESF_0_1"
      (rectangle
        (start -6.35 5.08)
        (end 6.35 -5.08)
        (stroke (width 0.254) (type default))
        (fill (type background))
      )
      ;; IR sensor icon (simplified thermal array)
      (polyline
        (pts (xy -3.81 2.54) (xy -1.27 2.54))
        (stroke (width 0.254) (type default))
        (fill (type none))
      )
      (polyline
        (pts (xy -3.81 1.27) (xy -1.27 1.27))
        (stroke (width 0.254) (type default))
        (fill (type none))
      )
      (polyline
        (pts (xy -3.81 0) (xy -1.27 0))
        (stroke (width 0.254) (type default))
        (fill (type none))
      )
      (polyline
        (pts (xy -3.81 -1.27) (xy -1.27 -1.27))
        (stroke (width 0.254) (type default))
        (fill (type none))
      )
      ;; IR waves
      (arc
        (start 2.54 1.27)
        (mid 3.175 0)
        (end 2.54 -1.27)
        (stroke (width 0.254) (type default))
        (fill (type none))
      )
      (arc
        (start 3.81 2.54)
        (mid 4.445 0)
        (end 3.81 -2.54)
        (stroke (width 0.254) (type default))
        (fill (type none))
      )
    )
    (symbol "MLX90640ESF_1_1"
      (pin power_in line
        (at -8.89 2.54 0)
        (length 2.54)
        (name "VDD" (effects (font (size 1.27 1.27))))
        (number "1" (effects (font (size 1.27 1.27))))
      )
      (pin power_in line
        (at -8.89 -2.54 0)
        (length 2.54)
        (name "VSS" (effects (font (size 1.27 1.27))))
        (number "2" (effects (font (size 1.27 1.27))))
      )
      (pin bidirectional line
        (at 8.89 2.54 180)
        (length 2.54)
        (name "SDA" (effects (font (size 1.27 1.27))))
        (number "3" (effects (font (size 1.27 1.27))))
      )
      (pin input line
        (at 8.89 -2.54 180)
        (length 2.54)
        (name "SCL" (effects (font (size 1.27 1.27))))
        (number "4" (effects (font (size 1.27 1.27))))
      )
    )
  )

