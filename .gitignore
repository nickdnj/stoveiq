# Build
.pio/
build/
__pycache__/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Credentials — NEVER commit these
.env
wifi_config.h
sdkconfig
sdkconfig.old
# TLS private key + generated header (run scripts/gen-cert.sh to regenerate)
firmware/src/certs/server.key
firmware/src/certs/server.crt
firmware/src/certs.h

# Generated
firmware/data/*.gz
# ESP-IDF managed component cache and per-env build artifacts
firmware/managed_components/
firmware/dependencies.lock
firmware/CMakeLists.txt
firmware/sdkconfig.esp32s3

# Generated by AgentArchitect sync — regenerate with: aa sync <this repo>
.claude/agents/*.md
.claude/skills/*/SKILL.md
.claude/settings.local.json

# Video production media — ~424MB of renders, narration and music beds.
# Too big for a public repo, and all of it is re-derivable from the script
# and storyboard, which stay tracked. Ignored: assembly/, audio/, output/,
# and assets/ (AI-generated stills). Un-ignore assets/ if the cut should be
# reproducible straight from a clone.
video/*
!video/scripts/
!video/assemble_v1.py

# KiCad per-user / editor artifacts — the project, schematic and layout are
# tracked; local window state and autosaves are not.
*.kicad_prl
*-backups/
*.kicad_pcb-bak
*.kicad_sch-bak
fp-info-cache

# Generated by tools/ui-screenshots/extract.py — re-derive it from web_server.c
tools/ui-screenshots/index.html
